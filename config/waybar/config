{
  "layer": "top",
  "position": "top",
  "height": 30,
  "margin-top": 4,
  "margin-bottom": 6,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 8,
  "modules-left": [
    "cpu",
    "memory",
    "temperature"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "pulseaudio",
    "network",
    "battery",
    "tray"
  ],
  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%A %d %B %Y}",
    "on-click": "launch-system-widget.sh"
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "",
    "format-icons": {
      "headphones": "",
      "default": [
        "",
        "",
        ""
      ]
    }
  },
  "network": {
    "format-wifi": "   {signalStrength}%",
    "format-ethernet": "󰈀   {ipaddr}",
    "format-disconnected": "󰖪   sin red"
  },
  "battery": {
    "format": "{icon}  {capacity}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
  "cpu": {
    "format": "  {usage}%",
    "interval": 2
  },
  "memory": {
    "format": "  {used:0.1f}G",
    "interval": 2
  },
  "temperature": {
    "format": "  {temperatureC}°C",
    "interval": 2
  }
}